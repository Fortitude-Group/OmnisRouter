<Project>
  <!--
    T061 self-host publish profile: one self-contained, single-file executable with no separate
    .NET runtime install required on the target machine (FR-015 "single self-contained process").

    Defaults to linux-x64 (the same target as deploy/Dockerfile's efbundle-* artifacts). Override
    per-platform from the CLI — the -r flag takes precedence over this file's RuntimeIdentifier:

      dotnet publish src/OmnisRouter.Api -p:PublishProfile=selfhost -r win-x64
      dotnet publish src/OmnisRouter.Api -p:PublishProfile=selfhost -r osx-arm64
      dotnet publish src/OmnisRouter.Api -p:PublishProfile=selfhost -r linux-x64

    Output lands in bin/Release/net10.0/<rid>/publish/. The published folder does NOT include
    config/ or routing/ (they're repo-root data directories, not project content) — copy them
    alongside the executable before running; see docs/self-host.md. This profile does not run
    database migrations — see docs/self-host.md "Applying database migrations" for the
    `dotnet ef database update` step needed before first run (Program.cs has no startup
    auto-migrate, deliberately, so it stays out of scope for this packaging change).
  -->
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <PublishProtocol>FileSystem</PublishProtocol>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>
</Project>
