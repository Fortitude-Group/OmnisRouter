<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\OmnisRouter.Collect\OmnisRouter.Collect.csproj" />
    <ProjectReference Include="..\OmnisRouter.Core\OmnisRouter.Core.csproj" />
    <ProjectReference Include="..\OmnisRouter.Adapters\OmnisRouter.Adapters.csproj" />
    <ProjectReference Include="..\OmnisRouter.Routing\OmnisRouter.Routing.csproj" />
    <ProjectReference Include="..\OmnisRouter.Upstream\OmnisRouter.Upstream.csproj" />
    <ProjectReference Include="..\OmnisRouter.Store\OmnisRouter.Store.csproj" />
    <ProjectReference Include="..\OmnisRouter.Telemetry\OmnisRouter.Telemetry.csproj" />
    <ProjectReference Include="..\OmnisRouter.Vigil\OmnisRouter.Vigil.csproj" />
    <ProjectReference Include="..\OmnisRouter.Store.Migrations.Sqlite\OmnisRouter.Store.Migrations.Sqlite.csproj" />
    <ProjectReference Include="..\OmnisRouter.Store.Migrations.Npgsql\OmnisRouter.Store.Migrations.Npgsql.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Lets the test project drive the internal collect CLI renderer (golden output, FR-020). -->
    <InternalsVisibleTo Include="OmnisRouter.Api.Tests" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- The shipped command is `omnisrouter` (and `omnisrouter collect`), so the published
         binary is named omnisrouter(.exe), not OmnisRouter.Api(.exe). -->
    <AssemblyName>omnisrouter</AssemblyName>
  </PropertyGroup>

</Project>
