<?xml version="1.0" encoding="utf-8"?>
<!--
  Per-user MSI for the OmnisRouter collect tray (feature 002-collect-tray-app, US5).
  Build (needs the UI + Util extensions: wix extension add -g WixToolset.UI.wixext/5.0.2 ; same for Util):
    wix build installer/msi/OmnisRouter.wxs -arch x64 -ext WixToolset.UI.wixext -ext WixToolset.Util.wixext
      -d PublishDir=<tray publish dir> -d Version=<x.y.z> -d LicenseRtf=<License.rtf>
      -d DialogBmp=<dialog.bmp> -d BannerBmp=<banner.bmp> -o OmnisRouter.msi
  Per-user scope means no elevation (FR-017). The app registers its own "at log on" Scheduled Task;
  this MSI removes that task on uninstall so nothing is left behind (FR-019).
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <Package
      Name="OmnisRouter"
      Manufacturer="Fortitude Omnis"
      Version="$(Version)"
      UpgradeCode="7B1C0E9E-3A2D-4C7F-9E21-2A8B6D4F1C33"
      Scope="perUser"
      Compressed="yes">

    <!-- Remove the old version and install the new one in a single transaction on any real upgrade.
         AllowSameVersionUpgrades lets a rebuild of the same version replace the installed copy cleanly
         (the test-and-reinstall loop) instead of a repair or a duplicate ARP entry. A genuine downgrade
         is still refused, with the message below. -->
    <MajorUpgrade
        AllowSameVersionUpgrades="yes"
        DowngradeErrorMessage="A newer version of OmnisRouter is already installed. Uninstall it first if you mean to install this older build." />
    <MediaTemplate EmbedCab="yes" />

    <!-- Close the running tray AND the router it bundles before upgrading, so the new version takes over
         and neither locks the files being replaced. The tray closes first (lower Sequence) so it cannot
         restart the router as its supervisor while the install is running; the router is closed second.
         Both are terminated rather than sent a window message: the tray lives behind a single-instance
         mutex with no top-level window, and omnisrouter.exe is a windowless server, so there is no
         window for a close message to reach. An orphaned router from an earlier session is closed the
         same way, since these match by executable name, not by parent process. -->
    <!-- Close only our own processes on upgrade. We let the Restart Manager stay ON: it precisely
         identifies which processes lock the files being replaced (the tray and the bundled router), so
         it never implicates unrelated apps. Disabling it fell back to the legacy file-in-use scan, which
         wrongly flagged unrelated programs such as Outlook, so that is deliberately NOT done here. The
         tray closes first (lower Sequence) so it cannot restart the router mid-install; both are
         terminated because neither has a top-level window for a close message. -->
    <util:CloseApplication Id="CloseTray" Target="OmnisRouter.Tray.exe" CloseMessage="no" TerminateProcess="0" RebootPrompt="no" Sequence="1" />
    <util:CloseApplication Id="CloseRouter" Target="omnisrouter.exe" CloseMessage="no" TerminateProcess="0" RebootPrompt="no" Sequence="2" />

    <!-- A real installer UI: welcome + licence, then a completion page that confirms the install
         and offers to launch the app, so it never just installs and vanishes. Branded with the
         Fortitude lion and navy. -->
    <WixVariable Id="WixUILicenseRtf" Value="$(LicenseRtf)" />
    <WixVariable Id="WixUIDialogBmp" Value="$(DialogBmp)" />
    <WixVariable Id="WixUIBannerBmp" Value="$(BannerBmp)" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch OmnisRouter" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <ui:WixUI Id="WixUI_Minimal" />
    <UI>
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchTray"
               Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 and NOT Installed" />
    </UI>

    <!-- Add/Remove Programs metadata. -->
    <Property Id="ARPPRODUCTICON" Value="OmnisRouterIcon" />
    <Property Id="ARPURLINFOABOUT" Value="https://app.omnisvigil.com" />
    <Icon Id="OmnisRouterIcon" SourceFile="$(PublishDir)\OmnisRouter.Tray.exe" />

    <!-- Per-user install location: %LOCALAPPDATA%\Programs\OmnisRouter -->
    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="OmnisRouter" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="AppShortcutFolder" Name="OmnisRouter" />
    </StandardDirectory>

    <Feature Id="Main" Title="OmnisRouter" Level="1">
      <ComponentGroupRef Id="TrayFiles" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>

    <!-- Harvest the self-contained publish output. -->
    <ComponentGroup Id="TrayFiles" Directory="INSTALLFOLDER">
      <Files Include="$(PublishDir)\**" />
    </ComponentGroup>

    <!-- Start-Menu shortcut + the per-user keypath that owns the shortcut folder's removal. -->
    <Component Id="StartMenuShortcut" Directory="AppShortcutFolder" Guid="A4E7F2C1-9B3D-4E56-8F0A-1C2D3E4F5A6B">
      <Shortcut Id="AppShortcut"
                Name="OmnisRouter"
                Description="OmnisRouter subscription collect watcher"
                Target="[INSTALLFOLDER]OmnisRouter.Tray.exe"
                WorkingDirectory="INSTALLFOLDER" />
      <RemoveFolder Id="RemoveAppShortcutFolder" On="uninstall" />
      <RegistryValue Root="HKCU" Key="Software\FortitudeOmnis\OmnisRouter" Name="installed" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <!-- On uninstall, remove the login task the app created. Never fail uninstall if it is absent. -->
    <CustomAction Id="RemoveLoginTask"
                  Directory="INSTALLFOLDER"
                  ExeCommand="schtasks.exe /delete /tn &quot;OmnisRouter Collect&quot; /f"
                  Execute="deferred"
                  Impersonate="yes"
                  Return="ignore" />
    <!-- Launched from the completion page's "Launch OmnisRouter" checkbox (see the Publish above). -->
    <CustomAction Id="LaunchTray"
                  Directory="INSTALLFOLDER"
                  ExeCommand="&quot;[INSTALLFOLDER]OmnisRouter.Tray.exe&quot;"
                  Execute="immediate"
                  Impersonate="yes"
                  Return="asyncNoWait" />

    <InstallExecuteSequence>
      <Custom Action="RemoveLoginTask" Before="RemoveFiles" Condition="REMOVE=&quot;ALL&quot;" />
    </InstallExecuteSequence>
  </Package>
</Wix>
